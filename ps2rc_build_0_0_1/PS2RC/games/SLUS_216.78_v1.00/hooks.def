/* hooks.def - BT3 (SLUS-216.78 v1.00): Sony library functions bound to the core's HLE implementations.
 *
 * Addresses and names come from the Tenkaichi3Decomp symbol files (config/symbol_addrs.txt, config/symbols/*.txt),
 * which identify each library function of this exact boot program; kept here are the names the core implements
 * (HLE_SCE in hle/core). Generated by C:/bt3ps2rc/gen_hooks.py; translate again after a change.
 *
 * _InitSys (002ba4a0) is deliberately NOT hooked: the game's own one installs its kernel patch (syscalls 91,
 * 252-255, 8) that the rest of the game calls; that path runs translated (overlay 1, see src/pack_main.c).
 */

HOOK(002930b8, sceGsResetGraph)
HOOK(00293258, sceGsResetPath)
HOOK(002936a0, sceGsSyncV)
HOOK(00293738, sceGsSyncPath)
HOOK(00293b90, sceGsExecStoreImage)
HOOK(002a2738, sceMcUdCheckNewCard)
HOOK(002a40b0, sceCdInit)
HOOK(002a4d48, sceCdMmode)
HOOK(002a9a1c, memcpy)
HOOK(002a9acc, memset)
HOOK(002b0800, Exit)
HOOK(002b1aa8, iWakeupThread)
HOOK(002b1bc0, iSuspendThread)
HOOK(002b1c58, DelayThread)
HOOK(002b1d20, StartThread)
HOOK(002b3808, sceSifInitCmd)
HOOK(002b3f68, sceSifInitRpc)
HOOK(002b4710, sceSifBindRpc)
HOOK(002b48f0, sceSifCallRpc)
HOOK(002b5ac8, sceFsReset)
HOOK(002b5d30, sceOpen)
HOOK(002b5fc0, sceClose)
HOOK(002b6138, sceLseek)
HOOK(002b6378, sceRead)
HOOK(002b65e8, sceWrite)
HOOK(002b68a8, sceIoctl)
HOOK(002b7918, sceGetstat)
HOOK(002b8398, sceLseek64)
HOOK(002b8c58, sceSifInitIopHeap)
HOOK(002b8ce0, sceSifAllocIopHeap)
HOOK(002b8e68, sceSifLoadIopHeap)
HOOK(002ba088, sceSifSyncIop)
HOOK(002ba0d8, sceSifRebootIop)

/* not named in the decomp: the worker sceSifLoadModule (002b9ba8) calls as (name, argLen, args, &result, 0),       */
/* i.e. _sceSifLoadModule; the core loads modules at this level (its LoadFile RPC client init is at 002b91a8)        */
HOOK(002b9980, _sceSifLoadModule)

/* not named in the decomp: libcdvd file search, identified from its body - it copies the name (<= 256 bytes) into   */
/* the request, adds the layer (3rd argument), calls server 0x80000597 fno 0 and copies the 32-byte sceCdlFILE out */
HOOK(002a3888, sceCdLayerSearchFile)

/* not named in the decomp: no arguments, N-command server 0x80000595 fno 14 (disk ready), returns the IOP's word */
HOOK(002a3d00, sceCdNcmdDiskReady)

